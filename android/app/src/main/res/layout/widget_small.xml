<?xml version="1.0" encoding="utf-8"?>
<!-- The GymDay widget when it is only one row high: two lines and the one button that matters most. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_s1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_s2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="#8C9BB6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <Chronometer android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textColor="#22E3FF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/w_start" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="10dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:background="@drawable/btn_main"
        android:textColor="#04121F" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
</LinearLayout>
