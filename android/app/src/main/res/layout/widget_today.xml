<?xml version="1.0" encoding="utf-8"?>
<!-- v1.25: the Today widget (4 x 2): readiness, calories left and the next workout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY"
        android:textColor="#22E3FF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/t_ready" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/t_word" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp"
            android:textColor="#EAF2FF" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>

    <TextView android:id="@+id/t_kcal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#EAF2FF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/t_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="#8C9BB6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
