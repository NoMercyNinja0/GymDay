<?xml version="1.0" encoding="utf-8"?>
<!-- The GymDay widget at its normal size (4 x 2): this week, today's day with Start, and the running workout with its buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name"
            android:textColor="#22E3FF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#EAF2FF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_dots" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="9dp" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d0" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="M" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d1" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="T" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d2" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="W" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d3" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="T" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d4" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="F" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d5" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="S" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/w_d6" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:gravity="center"
                android:text="S" android:textSize="11sp" android:textStyle="bold" android:textColor="#8C9BB6" android:background="@drawable/dot_off" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_idle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#8C9BB6" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:id="@+id/w_today" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_start" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="10dp"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:gravity="center" android:background="@drawable/btn_main"
            android:textColor="#04121F" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_work" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp"
        android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/w_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textColor="#22E3FF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_frozen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:textColor="#8C9BB6" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="#8C9BB6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="7dp" android:progressDrawable="@drawable/bar_sets" android:max="1" android:progress="0" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_b0" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1.25" android:gravity="center"
                android:background="@drawable/btn_main" android:textColor="#04121F" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center"
                android:background="@drawable/btn_soft" android:textColor="#EAF2FF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center"
                android:background="@drawable/btn_soft" android:textColor="#EAF2FF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
