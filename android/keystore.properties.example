# Release signing for GymDay.
# Copy this file to keystore.properties (git ignores it) and fill in your own release key.
# Never commit keystore.properties or the key file. Keep the key file outside the repository if you can.
# storeFile is a full path, or a path from this android/ folder.
storeFile=/full/path/to/your-release-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
